<!doctype html>
<html lang="it">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>URL Shortener lab</title>
<style>
body{font-family:system-ui,sans-serif;max-width:560px;margin:3rem auto;padding:0 1rem}
input,button{width:100%;padding:.6rem;margin:.3rem 0;box-sizing:border-box}
#out{margin-top:1rem;word-break:break-all}
</style>
</head>
<body>
<h1>URL Shortener</h1>
<input id="url" type="url" placeholder="https://esempio.it/pagina-lunga">
<input id="key" type="password" placeholder="API key" autocomplete="off">
<button id="go">Accorcia</button>
<div id="out"></div>
<script>
const API = "${api_url}";
document.getElementById("go").onclick = async () => {
  const out = document.getElementById("out");
  out.textContent = "...";
  try {
    const r = await fetch(API + "/shorten", {
      method: "POST",
      headers: {"Content-Type": "application/json",
                "x-api-key": document.getElementById("key").value},
      body: JSON.stringify({url: document.getElementById("url").value})
    });
    const data = await r.json().catch(() => ({}));
    if (r.status === 201) {
      out.innerHTML = "";
      const a = document.createElement("a");
      a.href = data.short_url; a.textContent = data.short_url; a.target = "_blank";
      out.appendChild(a);
    } else {
      out.textContent = r.status + " " + (data.error || data.message || "");
    }
  } catch (e) {
    out.textContent = "Errore di rete o CORS: " + e.message;
  }
};
</script>
</body>
</html>